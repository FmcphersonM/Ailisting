# Copy this file to ".env" for local development. Never commit the real ".env".
# On Render these are set in the service's "Environment" page instead.

# Your Anthropic API key (starts with sk-ant-). Required for real listings.
ANTHROPIC_API_KEY=

# The passcode you type once on your phone to open the app.
APP_PASSCODE=

# Postgres connection string. On Render this is filled in automatically.
DATABASE_URL=postgres://selg:selg@localhost:5432/selg

# Optional settings
# CLAUDE_MODEL=claude-opus-5-5     # which Claude model writes the listings
# CLAUDE_EFFORT=medium             # low | medium | high (higher = more careful, costs more)
# USD_TO_NOK=10.5                  # exchange rate used to show API fees in kroner
# SESSION_SECRET=                  # any long random text; keeps logins valid
# FAKE_AI=1                        # development only: canned listings, no Claude calls
